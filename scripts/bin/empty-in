#!/usr/bin/env bash
# vim:set ft=bash:

set -euo pipefail

exec 3>&1 # make stdout available as fd 3 for the result
exec 1>&2 # redirect all output to stderr for logging

# Guarantee Concourse always receives a valid JSON object on stdout, even on failure.
trap 'echo "{}" >&3' ERR

payload=$(cat <&0)
timestamp=$(jq --raw-output '.version.timestamp // "none"' <<< "${payload}")

# Response with the given timestamp version object, if provided
jq --null-input --arg "timestamp" "${timestamp}" '{version:{timestamp:$timestamp}}' >&3

#!/usr/bin/env bash
# vim:set ft=bash:

set -euo pipefail

exec 3>&1 # make stdout available as fd 3 for the result
exec 1>&2 # redirect all output to stderr for logging

LIB_DIR=$(realpath "$(dirname "${0}")/../lib")
export LIB_DIR

# shellcheck source=../lib/common.sh
source "${LIB_DIR}/common.sh"
# shellcheck source=../lib/payload.sh
source "${LIB_DIR}/payload.sh"
# shellcheck source=../lib/packages.sh
source "${LIB_DIR}/packages.sh"
# shellcheck source=../lib/database.sh
source "${LIB_DIR}/database.sh"

log:info "Initialising Arch Linux repository database upload"

check:commands aws jq logger uuidgen

# If this source is disabled, return an empty array to indicate no versions
if [[ "$(payload:source disable false false)" == "true" ]]; then
  echo "[]" >&3
  exit 0
fi

if test -z "${1:-}"; then
  log:fatal "Missing working directory argument"
fi

cd "${1}"

endpoint=$(payload:source endpoint)
region=$(payload:source region true weur)
bucket=$(payload:source bucket)
repository=$(payload:source repository)
arch=$(payload:source arch)
prefix="s3://${bucket}/${repository}/os/${arch}"

check:variables endpoint region bucket repository arch

access_key_id=$(payload:source access_key_id true "" true)
secret_access_key=$(payload:source secret_access_key true "" true)

check:variables access_key_id:sensitive secret_access_key:sensitive

export AWS_ACCESS_KEY_ID="${access_key_id}"
export AWS_SECRET_ACCESS_KEY="${secret_access_key}"
export AWS_ENDPOINT_URL="${endpoint}"
export AWS_DEFAULT_REGION="${region}" AWS_REGION="${region}"

function failure {
  echo -n '{}' >&3
  log:fatal "Failed to upload the repository database" repository="${prefix}" database="${repository}.db.tar.gz"
}

# If any of the following commands fail, then handle the failure with the failure() function above. This will simplify
# the error handling and logging, and ensure that the output is always in the expected format for Concourse.
trap failure ERR

database:put "database/${repository}.db.tar.gz" "${prefix}"

log:info "Repository database successfully uploaded" repository="${prefix}" database="${repository}.db.tar.gz"

# Wait a few seconds to ensure the latest version of the database is available for retrieval, as R2 may not immediately
# reflect the updated object. Although S3 is generally now strongly consistent, R2 may have consistency delays.
sleep 3

etag=$(database:etag "${bucket}" "${repository}/os/${arch}/${repository}.db.tar.gz")
jq --monochrome-output --compact-output --null-input \
--arg "etag" "${etag}" --arg "name" "${repository}" \
'{ "version": {"etag":$etag},
   "metadata": [
     {"name":"name","value":$name},
     {"name":"etag","value":$etag}
   ]
 }' >&3

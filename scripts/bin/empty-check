#!/usr/bin/env bash
# vim:set ft=bash:

set -euo pipefail

exec 3>&1 # make stdout available as fd 3 for the result
exec 1>&2 # redirect all output to stderr for logging

# Guarantee Concourse always receives a valid JSON array on stdout, even on failure.
trap 'echo "[]" >&3' ERR

payload=$(cat <&0)
timestamp=$(jq --raw-output '.version.timestamp // empty' <<< "${payload}")

if [[ -z "${timestamp}" ]]; then
  echo '[]' >&3
else
  jq --null-input --arg "timestamp" "${timestamp}" '[{timestamp:$timestamp}]' >&3
fi

#!/usr/bin/env bash
# vim:set ft=bash:

set -euo pipefail

exec 3>&1 # make stdout available as fd 3 for the result
exec 1>&2 # redirect all output to stderr for logging

# Guarantee Concourse always receives a valid JSON object on stdout, even on failure.
trap 'echo "{}" >&3' ERR

# Output an empty version object with the current timestamp
jq --null-input --arg "timestamp" "$(date --rfc-3339=seconds | sed -e 's/ /T/')" '{version:{timestamp:$timestamp}}' >&3

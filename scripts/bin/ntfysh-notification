#!/usr/bin/env bash
# vim:set ft=bash:

set -euo pipefail

exec 3>&1 # make stdout available as fd 3 for the result
exec 1>&2 # redirect all output to stderr for logging

LIB_DIR=$(realpath "$(dirname "${0}")/../lib")
export LIB_DIR

# shellcheck source=../lib/common.sh
source "${LIB_DIR}/common.sh"
# shellcheck source=../lib/payload.sh
source "${LIB_DIR}/payload.sh"
# shellcheck source=../lib/ntfysh.sh
source "${LIB_DIR}/ntfysh.sh"
# shellcheck source=../lib/metadata.sh
source "${LIB_DIR}/metadata.sh"

log:info "Initialising ntfy.sh notification upload"

check:commands jq logger mktemp uuidgen

payload:read

# If this source is disabled, return an empty array to indicate no versions
if [[ "$(payload:source disable false false)" == "true" ]]; then
  echo "{}" >&3
  exit 0
fi

endpoint=$(payload:source endpoint true "https://ntfy.sh")
topic=$(payload:source topic true)
repository=$(payload:params repository true)
arch=$(payload:params arch true "x86_64")
type=$(payload:params type false)
priority=$(payload:params priority true low)
title=$(payload:params title false)
message=$(payload:params message false)

check:variables endpoint topic repository priority
output:variables type title message

if test -z "${1:-}"; then
  log:fatal "Missing working directory argument"
fi

cd "${1}"

url=$(ntfysh:url:job)

case "${type:-custom}" in
  packages-build-error)
    base=$(payload:params base true)
    title=${title:-"${base} Package Build Error"}
    message=$(ntfysh:message:build:error "${repository}" "${arch}" "${base}")
    priority=${priority:-"high"}
    ;;
  packages-build-failure)
    base=$(payload:params base true)
    title=${title:-"${base} Package Build Failed"}
    message=$(ntfysh:message:build:failure "${repository}" "${arch}" "${base}")
    priority=${priority:-"high"}
    ;;
  packages-sign-failure)
    base=$(payload:params base true)
    version=$(metadata:release)
    title=${title:-"${base} Package Sign Failed"}
    message=$(ntfysh:message:sign:failure "${repository}" "${arch}" "${base}" "${version}")
    priority=${priority:-"high"}
    ;;
  packages-update-error)
    base=$(payload:params base true)
    title=${title:-"${repository} Repository Update Error"}
    message=$(ntfysh:message:update:error "${repository}" "${arch}" "${base}")
    priority=${priority:-"high"}
    ;;
  repository-update-success)
    base=$(payload:params base true)
    version=$(metadata:release)
    title=${title:-"${base} updated to v${version} in ${repository} Repository"}
    # Override the URL for the success job to point to the whole pipeline rather than a specific job, as we do not need
    # to target that job to review errors or logs
    url=$(ntfysh:url:pipeline)
    message=$(ntfysh:message:update:success "${repository}" "${arch}" "${base}" "${version}")
    priority=${priority:-"low"}
    ;;
  repository-update-failure)
    base=$(payload:params base true)
    version=$(metadata:release)
    title=${title:-"${repository} Repository Update Failure"}
    message=$(ntfysh:message:update:failure "${repository}" "${arch}" "${base}" "${version}")
    priority=${priority:-"high"}
    ;;
  repository-cleanup-failure)
    title=${title:-"${repository} Repository Cleanup Failure"}
    message=$(ntfysh:message:cleanup:failure "${repository}" "${arch}")
    priority=${priority:-"high"}
    ;;
  custom)
    if test -z "${title}"; then
      log:fatal "Missing title for custom notification" type="custom"
    elif test -z "${message}"; then
      log:fatal "Missing message for custom notification" type="custom"
    fi
    ;;
  *)
    log:fatal "Unknown message type requested" type="${type}"
    ;;
esac

case "${priority}" in
  low|default|normal|high|urgent) ;;
  *) log:fatal "Invalid priority requested for notification" priority="${priority}" ;;
esac

sequence=$(uuidgen -r)
ntfysh:send "${endpoint}/${topic}" "${sequence}" "${priority}" "${title}" "${message}" "${url}"

jq --monochrome-output --compact-output --null-input \
  --arg "sequence" "${sequence}" --arg "type" "${type:-custom}" --arg "priority" "${priority}" \
  '{"version":{"sequence":$sequence},"metadata":[{"name":"type","value":$type},{"name":"priority","value":$priority}]}' >&3

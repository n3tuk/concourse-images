#!/usr/bin/env bash
# vim:set ft=bash:

set -euo pipefail

LIB_DIR=$(realpath "$(dirname "${0}")/../lib")
export LIB_DIR

# shellcheck source=../lib/common.sh
source "${LIB_DIR}/common.sh"
# shellcheck source=../lib/build.sh
source "${LIB_DIR}/build.sh"

log:info "Initialising Arch Linux Repository package signer" workdir="${PWD:-}"

check:commands gpg jq logger uuidgen

check:variables gpg_fingerprint gpg_private_key:sensitive gpg_passphrase:sensitive

build:import "${gpg_private_key}" "${gpg_passphrase}"
build:sign packages "0x${gpg_fingerprint}" "${gpg_passphrase}"
# build:cleanup "${gpg_fingerprint}"

log:info "All built packages successfully signed"
